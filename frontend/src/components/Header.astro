---
import { readFileSync } from 'node:fs';
import type { SeasonsIndex } from '../lib/types';
import { seasonUrl } from '../lib/helpers';

const raw = readFileSync('public/data/seasons.json', 'utf-8');
const index: SeasonsIndex = JSON.parse(raw);
const path = Astro.url.pathname;
const currentSlug = path.match(/^\/staffel\/([^/]+)/)?.[1];
const currentSeason = index.seasons.find((season) => season.id === currentSlug)
  ?? index.seasons.find((season) => season.current)
  ?? index.seasons[0];
---

<header class="nav">
  <div class="wrap nav-in">
    <a href="/" class="brand" aria-label="AYTO Matches — Startseite">
      <!-- him (blue) + her (pink) overlap → match (violet) -->
      <svg width="38" height="26" viewBox="0 0 38 26" fill="none" aria-hidden="true">
        <circle cx="14" cy="13" r="10.5" fill="#65a6ff" fill-opacity="0.92" style="mix-blend-mode:screen" />
        <circle cx="24" cy="13" r="10.5" fill="#ff6fae" fill-opacity="0.92" style="mix-blend-mode:screen" />
      </svg>
      <span class="brand-name">AYTO<i>matches</i></span>
    </a>

    <div class="nav-right">
      <div class="picker">
        <label for="seasonSelect" class="sr-only">Staffel wählen</label>
        <select id="seasonSelect" class="nav-season-select" aria-label="Staffel wählen">
          {index.seasons.map((season) => (
            <option value={seasonUrl(season.id)} selected={season.id === currentSeason.id}>
              {season.display_name}{season.current ? ' · aktuell' : ''}
            </option>
          ))}
        </select>
      </div>
      <a class="navlink" href="https://github.com/nbgit10/ayto_solver" target="_blank" rel="noopener">Solver ↗</a>
    </div>
  </div>
</header>

<script>
  const seasonSelect = document.querySelector<HTMLSelectElement>('#seasonSelect');
  seasonSelect?.addEventListener('change', () => {
    if (seasonSelect.value) window.location.href = seasonSelect.value;
  });
</script>
