---
import type { SeasonIndexEntry } from '../lib/types';
import { seasonUrl } from '../lib/helpers';

interface Props {
  season: SeasonIndexEntry;
  index?: number;
}

const { season, index = 0 } = Astro.props;

const statusLabel = season.infeasible
  ? 'Passt nicht zusammen'
  : season.total_solutions === 1
    ? 'Komplett gelöst'
    : `${season.total_solutions.toLocaleString('de-DE')} Möglichkeiten`;

// certainty 0..1 → drives the heat strip width + colour
const certainty = season.infeasible
  ? 0
  : season.total_solutions <= 1
    ? 1
    : Math.max(0.06, 1 / Math.sqrt(season.total_solutions));

const statusColor = season.infeasible
  ? '#ff5d5d'
  : season.total_solutions === 1
    ? '#ffd166'
    : '#c86bff';

const num = String(index + 1).padStart(2, '0');
const confirmedLabel = season.confirmed_matches === 1 ? '1 Fix-Match' : `${season.confirmed_matches} Fix-Matches`;
---

<a
  href={seasonUrl(season.id)}
  class="scard reveal group"
  style={`animation-delay:${0.05 * index + 0.1}s`}
>
  <div class="top">
    <span class="idx">{num}</span>
    {season.type === 'vip' && (
      <span class="pill gold">VIP</span>
    )}
  </div>

  <h3>{season.display_name}</h3>
  <p class="sub">{season.year} · Folge {season.latest_episode} von {season.total_episodes}</p>

  <!-- heat strip: how close to fully solved -->
  <div class="heatbar">
    <i
      style={`width:${Math.round(certainty * 100)}%;background:linear-gradient(90deg,#3a5fb0,${statusColor})`}></i>
  </div>

  <div class="foot">
    <span style={`color:${statusColor}`}>{statusLabel}</span>
    {season.confirmed_matches > 0 && (
      <span>{confirmedLabel}</span>
    )}
  </div>
</a>
