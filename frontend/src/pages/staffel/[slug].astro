---
import Base from '../../layouts/Base.astro';
import CertaintyMeter from '../../components/CertaintyMeter.svelte';
import ConfirmedMatches from '../../components/ConfirmedMatches.svelte';
import MatchCard from '../../components/MatchCard.svelte';
import MatchGrid from '../../components/MatchGrid.svelte';
import DoubleMatchInfo from '../../components/DoubleMatchInfo.svelte';
import type { SeasonsIndex, SeasonData } from '../../lib/types';
import { readFileSync } from 'node:fs';

export function getStaticPaths() {
  const raw = readFileSync('public/data/seasons.json', 'utf-8');
  const index: SeasonsIndex = JSON.parse(raw);

  return index.seasons.map((season) => ({
    params: { slug: season.id },
  }));
}

const slug = Astro.params.slug;
if (!slug) throw new Error('Missing season slug');
const dataRaw = readFileSync(`public/data/${slug}/latest.json`, 'utf-8');
const data: SeasonData = JSON.parse(dataRaw);
const topMatching = data.top_matching ?? [];
const maxNightMatches = Math.max(1, ...data.matching_nights.map((n) => n.matches));
---

<Base
  title={`${data.meta.display_name} — AYTO Matches`}
  description={`Match-Chancen für ${data.meta.display_name} (${data.meta.year}) — Folge ${data.meta.latest_episode} von ${data.meta.total_episodes}.`}
>
  <!-- ============ SEASON MASTHEAD ============ -->
  <header class="mx-auto max-w-[1180px] px-5 pb-8 pt-10 sm:px-8 sm:pb-10 sm:pt-14">
    <a href="/" class="reveal group inline-flex items-center gap-2 font-mono text-[0.7rem] font-medium text-[var(--color-bone-mut)] transition-colors hover:text-[var(--color-bone)]">
      <span class="transition-transform group-hover:-translate-x-1">&larr;</span> Zur Übersicht
    </a>

    <div class="reveal mt-6 flex flex-wrap items-center gap-3" style="animation-delay:.08s">
      <span class="kicker">{data.meta.year} · Folge {data.meta.latest_episode} von {data.meta.total_episodes}</span>
      {data.meta.type === 'vip' && (
        <span class="pill border border-[var(--color-gold)] text-[var(--color-gold)]">VIP</span>
      )}
    </div>

    <h1 class="reveal mt-3 font-display text-[clamp(2.8rem,9vw,6rem)] font-black leading-none tracking-[-0.02em] text-[var(--color-bone)]"
        style="animation-delay:.14s">
      {data.meta.display_name}
    </h1>
    <p class="reveal mt-4 font-mono text-sm text-[var(--color-bone-dim)]" style="animation-delay:.2s">
      {data.contestants.males.length} Männer · {data.contestants.females.length} Frauen
      {data.contestants.is_unbalanced ? ' · ungleich verteilt' : ''}
    </p>
  </header>

  <div class="mx-auto max-w-[1180px] px-5 pb-8 sm:px-8">
    {data.solver_result.infeasible ? (
      <div class="card p-8" style="border-color:rgba(255,93,93,0.4);box-shadow:0 0 30px -12px rgba(255,93,93,0.5)">
        <p class="kicker" style="color:#ff5d5d">Passt nicht zusammen</p>
        <h2 class="mt-3 font-display text-3xl font-bold text-[var(--color-bone)]">Keine passende Kombination</h2>
        <p class="mt-3 text-[var(--color-bone-dim)] max-w-xl leading-relaxed">
          Die bekannten Matching Nights und Matchboxen widersprechen sich. Wahrscheinlich fehlt noch eine
          Info oder eine Zahl ist falsch.
        </p>
      </div>
    ) : (
      <div class="space-y-14 sm:space-y-16">
        <!-- The Oracle -->
        <section>
          <CertaintyMeter
            totalSolutions={data.solver_result.total_solutions}
            solved={data.solver_result.solved}
            confirmedCount={data.confirmed_matches.length}
            totalPairs={data.contestants.males.length}
            client:load
          />
        </section>

        <!-- Confirmed -->
        {data.confirmed_matches.length > 0 && (
          <section>
            <div class="section-head mb-5">
              <h2 class="font-display text-2xl font-bold text-[var(--color-bone)] sm:text-3xl">Fixe Perfect Matches</h2>
              <p class="text-[var(--color-gold)]">stehen fest</p>
            </div>
            <ConfirmedMatches matches={data.confirmed_matches} client:load />
          </section>
        )}

        <!-- Matchboxes -->
        {data.matchboxes.length > 0 && (
          <section>
            <div class="section-head mb-5">
              <h2 class="font-display text-2xl font-bold text-[var(--color-bone)] sm:text-3xl">Matchboxen</h2>
              <p>was bisher bekannt ist</p>
            </div>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {data.matchboxes.map((box) => (
                <div class="card p-4 sm:p-5">
                  <div class="flex items-center justify-between gap-3">
                    <span class="font-mono text-[0.65rem] text-[var(--color-bone-mut)]">
                      Matchbox {String(box.number).padStart(2, '0')}
                    </span>
                    {box.sold ? (
                      <span class="text-right font-mono text-[0.62rem] font-medium text-[var(--color-gold)]">
                        Verkauft{box.sold_price ? ` · ${box.sold_price.toLocaleString('de-DE')} €` : ''}
                      </span>
                    ) : box.match === null ? (
                      <span class="font-mono text-[0.62rem] text-[var(--color-bone-mut)]">
                        Noch offen
                      </span>
                    ) : (
                      <span class={`font-mono text-[0.62rem] font-medium ${box.match ? 'text-[var(--color-match-hi)]' : 'text-[var(--color-bone-mut)]'}`}>
                        {box.match ? 'Perfect Match' : 'Kein Match'}
                      </span>
                    )}
                  </div>
                  <div class="mt-3 text-base font-semibold leading-snug">
                    <span class="text-[var(--color-him)]">{box.male}</span>
                    <span class="text-[var(--color-bone-mut)] mx-1.5 font-display italic">&amp;</span>
                    <span class="text-[var(--color-her)]">{box.female}</span>
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Top matching -->
        {topMatching.length > 0 && (
          <section>
            <div class="section-head mb-5">
              <h2 class="font-display text-2xl font-bold text-[var(--color-bone)] sm:text-3xl">Die heißesten Paarungen</h2>
              <p>aktuell je Person</p>
            </div>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {topMatching.map((entry) => (
                <MatchCard pairing={entry} isDoubleMatch={entry.is_double} client:load />
              ))}
            </div>
          </section>
        )}

        <!-- The Matrix (centerpiece) -->
        <section>
          <div class="mb-2">
            <span class="kicker">Match-Chancen</span>
          </div>
          <h2 class="mb-1 font-display text-2xl font-bold text-[var(--color-bone)] sm:text-3xl">Alle Paarungen</h2>
          <p class="mb-5 max-w-2xl text-sm text-[var(--color-bone-dim)]">
            Je kräftiger die Farbe, desto höher die Chance auf ein Match.
          </p>
          <MatchGrid
            pairings={data.pairings}
            males={data.contestants.males}
            females={data.contestants.females}
            client:load
          />
        </section>

        <!-- Double match -->
        {data.double_match.applicable && data.double_match.candidates.length > 0 && (
          <section>
            <div class="section-head mb-5">
              <h2 class="font-display text-2xl font-bold text-[var(--color-bone)] sm:text-3xl">Wer hat das Doppel?</h2>
              <p>zwei Perfect Matches</p>
            </div>
            <DoubleMatchInfo doubleMatch={data.double_match} client:load />
          </section>
        )}

        <!-- Matching nights -->
        {data.matching_nights.length > 0 && (
          <section>
            <div class="section-head mb-5">
              <h2 class="font-display text-2xl font-bold text-[var(--color-bone)] sm:text-3xl">Matching Nights</h2>
              <p>was bisher feststand</p>
            </div>
            <div class="space-y-2.5">
              {data.matching_nights.map((night, i) => (
                <details class="card group" open={i === data.matching_nights.length - 1}>
                  <summary class="flex items-center justify-between gap-4 px-5 py-4 cursor-pointer list-none select-none">
                    <div class="flex items-center gap-4">
                      <span class="font-display text-2xl font-bold text-[var(--color-bone-mut)] group-open:text-[var(--color-match-hi)] transition-colors w-10">
                        {String(night.night_number).padStart(2, '0')}
                      </span>
                      <span class="font-mono text-[0.72rem] font-medium text-[var(--color-bone-dim)]">Nacht {night.night_number}</span>
                    </div>
                    <div class="flex items-center gap-3">
                      <div class="hidden sm:flex items-center gap-1">
                        {Array.from({ length: maxNightMatches }).map((_, k) => (
                          <span class="h-2 w-2 rounded-full" style={`background:${k < night.matches ? 'var(--color-match)' : 'var(--color-line-2)'}`}></span>
                        ))}
                      </div>
                      <span class="font-mono text-sm font-bold text-[var(--color-match-hi)]">{night.matches}</span>
                       <span class="font-mono text-[0.62rem] text-[var(--color-bone-mut)]">{night.matches === 1 ? 'Licht' : 'Lichter'}</span>
                    </div>
                  </summary>
                   <div class="px-5 pb-5 pt-1 border-t border-[var(--color-line)]">
                     {night.loners && night.loners.length > 0 && (
                        <p class="mt-3 font-mono text-[0.65rem] text-[var(--color-bone-mut)]">
                          Ohne Match: {night.loners.join(', ')}
                       </p>
                     )}
                     {night.blackout && (
                        <p class="mt-3 font-mono text-[0.65rem] text-[#ff5d5d]">
                         Blackout
                       </p>
                     )}
                     <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-1.5 mt-3">
                      {night.pairs.map(([male, female]) => (
                        <div class="flex items-center gap-2 text-sm py-1 border-b border-[var(--color-line)]/50">
                          <span class="text-[var(--color-him)] font-medium">{male}</span>
                          <span class="text-[var(--color-bone-mut)] font-display italic text-xs">&amp;</span>
                          <span class="text-[var(--color-her)] font-medium">{female}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                </details>
              ))}
            </div>
          </section>
        )}
      </div>
    )}
  </div>
</Base>

<style>
  details > summary::-webkit-details-marker { display: none; }
</style>
