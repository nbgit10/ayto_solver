---
import Base from '../../layouts/Base.astro';
import CertaintyMeter from '../../components/CertaintyMeter.svelte';
import ConfirmedMatches from '../../components/ConfirmedMatches.svelte';
import MatchCard from '../../components/MatchCard.svelte';
import MatchGrid from '../../components/MatchGrid.svelte';
import DoubleMatchInfo from '../../components/DoubleMatchInfo.svelte';
import type { SeasonsIndex, SeasonData } from '../../lib/types';
import { readFileSync } from 'node:fs';

export function getStaticPaths() {
  const raw = readFileSync('public/data/seasons.json', 'utf-8');
  const index: SeasonsIndex = JSON.parse(raw);

  return index.seasons.map((season) => ({
    params: { slug: season.id },
  }));
}

const slug = Astro.params.slug;
if (!slug) throw new Error('Missing season slug');
const dataRaw = readFileSync(`public/data/${slug}/latest.json`, 'utf-8');
const data: SeasonData = JSON.parse(dataRaw);
const topMatching = data.top_matching ?? [];
const maxNightMatches = Math.max(1, ...data.matching_nights.map((night) => night.matches));
const formatPrice = (price: number | null) => price === null ? '' : ` · ${price.toLocaleString('de-DE')} €`;
---

<Base
  title={`${data.meta.display_name} — AYTO Matches`}
  description={`Match-Chancen für ${data.meta.display_name} (${data.meta.year}) — Folge ${data.meta.latest_episode} von ${data.meta.total_episodes}.`}
>
  <div class="wrap season-view">
    <div>
      <a class="back" href="/"><span class="arw">←</span> Zur Übersicht</a>
      <header class="masthead" data-od-id="season-masthead">
        <div class="mrow">
          <span class="kicker">{data.meta.year} · Folge {data.meta.latest_episode} von {data.meta.total_episodes}</span>
          {data.meta.type === 'vip' && <span class="pill gold">VIP</span>}
        </div>
        <h1>{data.meta.display_name}</h1>
        <p class="sub">
          {data.contestants.males.length} Männer · {data.contestants.females.length} Frauen
          {data.contestants.is_unbalanced ? ' · ungleich verteilt' : ''}
        </p>
      </header>
    </div>

    {data.solver_result.infeasible ? (
      <section class="card" data-od-id="infeasible" style="padding:32px;border-color:color-mix(in oklab,var(--danger) 45%,var(--border))">
        <p class="kicker" style="color:var(--danger)">Passt nicht zusammen</p>
        <h2 style="margin-top:12px">Keine passende Kombination</h2>
        <p class="lead-sm" style="margin-top:12px">
          Die bekannten Matching Nights und Matchboxen widersprechen sich. Wahrscheinlich fehlt noch eine Info oder
          eine Zahl ist falsch.
        </p>
      </section>
    ) : (
      <div class="season-content">
        <section data-od-id="clarity">
          <CertaintyMeter
            totalSolutions={data.solver_result.total_solutions}
            solved={data.solver_result.solved}
            confirmedCount={data.confirmed_matches.length}
            totalPairs={data.contestants.males.length}
            client:load
          />
        </section>

        {data.confirmed_matches.length > 0 && (
          <section data-od-id="confirmed">
            <div class="sec-head">
              <h2>Fixe Perfect Matches</h2>
              <span class="meta" style="color:var(--color-gold)">stehen fest</span>
            </div>
            <ConfirmedMatches matches={data.confirmed_matches} client:load />
          </section>
        )}

        {data.matchboxes.length > 0 && (
          <section data-od-id="matchboxes">
            <div class="sec-head">
              <h2>Matchboxen</h2>
              <span class="meta">was bisher bekannt ist</span>
            </div>
            <div class="matchbox-grid">
              {data.matchboxes.map((box) => (
                <div class="matchbox">
                  <div class="matchbox-head">
                    <span class="matchbox-label">Matchbox {String(box.number).padStart(2, '0')}</span>
                    {box.sold ? (
                      <span class="meta" style="color:var(--color-gold)">Verkauft{formatPrice(box.sold_price)}</span>
                    ) : box.match === null ? (
                      <span class="meta">Noch offen</span>
                    ) : (
                      <span class="meta" style={`color:${box.match ? 'var(--accent-hi)' : 'var(--muted)'}`}>
                        {box.match ? 'Perfect Match' : 'Kein Match'}
                      </span>
                    )}
                  </div>
                  <div class="pair">
                    <span class="him">{box.male}</span>
                    <span class="pair-amp">&amp;</span>
                    <span class="her">{box.female}</span>
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

        {topMatching.length > 0 && (
          <section data-od-id="top-pairings">
            <div class="sec-head">
              <h2>Die heißesten Paarungen</h2>
              <span class="meta">aktuell je Person</span>
            </div>
            <div class="matches">
              {topMatching.map((entry) => (
                <MatchCard pairing={entry} isDoubleMatch={entry.is_double} client:load />
              ))}
            </div>
          </section>
        )}

        <section data-od-id="matrix">
          <div class="sec-head">
            <h2>Alle Paarungen</h2>
            <span class="meta">je kräftiger, desto wahrscheinlicher</span>
          </div>
          <MatchGrid
            pairings={data.pairings}
            males={data.contestants.males}
            females={data.contestants.females}
            client:load
          />
        </section>

        {data.double_match.applicable && data.double_match.candidates.length > 0 && (
          <section data-od-id="double-match">
            <div class="sec-head">
              <h2>Wer hat das Doppel?</h2>
              <span class="meta">zwei Perfect Matches</span>
            </div>
            <DoubleMatchInfo doubleMatch={data.double_match} client:load />
          </section>
        )}

        {data.matching_nights.length > 0 && (
          <section data-od-id="matching-nights">
            <div class="sec-head">
              <h2>Matching Nights</h2>
              <span class="meta">was bisher feststand</span>
            </div>
            <div class="nights">
              {data.matching_nights.map((night, index) => (
                <details class="night" open={index === data.matching_nights.length - 1}>
                  <summary>
                    <span class="row">
                      <span class="num">{String(night.night_number).padStart(2, '0')}</span>
                      <span class="nlabel">Nacht {night.night_number}</span>
                    </span>
                    <span class="mcount">
                      <span class="pips">
                        {Array.from({ length: maxNightMatches }).map((_, matchIndex) => (
                          <i class:list={{ on: matchIndex < night.matches }}></i>
                        ))}
                      </span>
                      <b>{night.matches}</b>
                      <small>{night.matches === 1 ? 'Licht' : 'Lichter'}</small>
                    </span>
                  </summary>
                  <div class="night-body">
                    {night.loners && night.loners.length > 0 && (
                      <p class="note">Ohne Match: {night.loners.join(', ')}</p>
                    )}
                    {night.blackout && <p class="note danger">Blackout</p>}
                    <div class="night-pairs">
                      {night.pairs.map(([male, female]) => (
                        <div class="npair">
                          <span class="him">{male}</span>
                          <span class="pair-amp">&amp;</span>
                          <span class="her">{female}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                </details>
              ))}
            </div>
          </section>
        )}
      </div>
    )}
  </div>
</Base>
