---
import Base from '../layouts/Base.astro';
import SeasonCard from '../components/SeasonCard.astro';
import type { SeasonsIndex } from '../lib/types';
import { seasonUrl } from '../lib/helpers';
import { readFileSync } from 'node:fs';

const raw = readFileSync('public/data/seasons.json', 'utf-8');
const index: SeasonsIndex = JSON.parse(raw);
const currentSeason = index.seasons.find((season) => season.current) ?? index.seasons[0];
const archiveSeasons = index.seasons.filter((season) => season.id !== currentSeason.id);
const solvedSeasons = index.seasons.filter((season) => season.total_solutions === 1 && !season.infeasible).length;
const participantCount = currentSeason.num_males + currentSeason.num_females;
---

<Base title="AYTO Matches — Wer ist wirklich ein Perfect Match?">
  <section class="hero wrap" data-od-id="hero">
    <p class="kicker">Are You The One? Deutschland · Zahlen statt Bauchgefühl</p>
    <h1>
      Wer ist wirklich ein <span class="grad">Perfect Match</span><span class="qm">?</span>
    </h1>
    <p class="lead">
      Jede Matching Night und jede Matchbox zählt. Wir zeigen dir, welche Paare laut Daten die besten Chancen haben
      — und wie sicher der Solver schon ist.
    </p>
    <div class="kpis">
      <span class="kpi"><b style="color:var(--color-him)">{index.seasons.length}</b> Staffeln</span>
      <span class="kpi"><b style="color:var(--accent-hi)">{solvedSeasons}</b> komplett gelöst</span>
      <span class="kpi"><b style="color:var(--color-her)">100%</b> Zahlen</span>
    </div>
  </section>

  <section class="wrap" data-od-id="current-season">
    <a class="feature card" href={seasonUrl(currentSeason.id)}>
      <div class="feature-glow"></div>
      <div class="feature-grid">
        <div>
          <div class="row" style="flex-wrap:wrap">
            <span class="live"><span class="dot"></span>Gerade aktuell</span>
            {currentSeason.type === 'vip' && <span class="pill gold">VIP</span>}
          </div>
          <h2 class="feature-title">{currentSeason.display_name}</h2>
          <p class="meta">{currentSeason.year} · Folge {currentSeason.latest_episode} von {currentSeason.total_episodes}</p>
          <span class="btn btn-primary" style="margin-top:24px">Staffel ansehen <span class="arw">→</span></span>
        </div>

        <dl class="ledger">
          <div>
            <dd data-count={currentSeason.total_solutions} style="color:var(--accent-hi)">0</dd>
            <dt>{currentSeason.total_solutions === 1 ? 'Möglichkeit' : 'Möglichkeiten'}</dt>
          </div>
          <div>
            <dd data-count={currentSeason.confirmed_matches} style="color:var(--color-gold)">0</dd>
            <dt>Fix-Matches</dt>
          </div>
          <div>
            <dd data-count={participantCount}>0</dd>
            <dt>Personen</dt>
          </div>
        </dl>
      </div>
    </a>
  </section>

  <section id="archiv" class="wrap archive-section scroll-mt-24" data-od-id="archive">
    <div class="sec-head">
      <h2>Alle Staffeln</h2>
      <span class="meta">{archiveSeasons.length} im Archiv</span>
    </div>
    <div class="cards">
      {archiveSeasons.map((season, index) => <SeasonCard season={season} index={index} />)}
    </div>
  </section>
</Base>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const formatNumber = (value: number) => Math.round(value).toLocaleString('de-DE');

  function countUp(element: HTMLElement) {
    const target = Number(element.dataset.count ?? '0');
    if (reduce || target <= 0) {
      element.textContent = formatNumber(target);
      return;
    }

    const duration = 1100;
    const start = performance.now();
    const tick = (now: number) => {
      const progress = Math.min(1, (now - start) / duration);
      const eased = 1 - Math.pow(1 - progress, 3);
      element.textContent = formatNumber(target * eased);
      if (progress < 1) requestAnimationFrame(tick);
      else element.textContent = formatNumber(target);
    };
    requestAnimationFrame(tick);
  }

  const counters = document.querySelectorAll<HTMLElement>('[data-count]');
  const observer = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (entry.isIntersecting) {
        countUp(entry.target as HTMLElement);
        observer.unobserve(entry.target);
      }
    }
  }, { threshold: 0.4 });
  counters.forEach((counter) => observer.observe(counter));
</script>
